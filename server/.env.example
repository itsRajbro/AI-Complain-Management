# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/complaint-db?retryWrites=true&w=majority

# JWT Secret Key (use any long random string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long

# OpenRouter AI API Key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
